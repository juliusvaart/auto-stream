# Hardware setup
STREAM_DEV=stream   # from asound.conf
MONITOR_DEV=monitor # from asound.conf

# Start-stop setup
THRESHOLD=-40    # audio dB threshold, below this is considered "silence"
CHECK_INTERVAL=2 # check every 2 seconds for audio level
SILENCE_TIMEOUT=60 # stop streaming after X seconds of silence

# Roon Connect
HTTP_PORT=4567 # local port the stream server listens on; Roon pulls audio from here
ROON_EXTENSION_ID=com.recordplayer.autostream # optional, default shown
ROON_DISPLAY_NAME=Recordplayer    # optional, default shown
ROON_DISPLAY_LINE2=Nice brand    # optional, default shown

# Logging
VERBOSE=false # set to true to see per-tick level readings and recognition polling
